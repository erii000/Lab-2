# Copy to global-settings.env (gitignored) and fill in real values.
# ASP.NET Core reads these as environment variables (double underscore = nested config).

# Docker / team (Azure lab) — use this in global-settings.env:
ConnectionStrings__DefaultConnection=Server=tcp:sqladminlab.database.windows.net,1433;Initial Catalog=lab2DB;User ID=sqladmin;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;

# Windows only, APIs run outside Docker:
# ConnectionStrings__DefaultConnection=Server=(localdb)\mssqllocaldb;Database=lab2DB;Trusted_Connection=True;TrustServerCertificate=True;

# Docker with local SQL profile (docker compose --profile local-sql up):
# ConnectionStrings__DefaultConnection=Server=mssql,1433;Initial Catalog=lab2DB;User ID=sa;Password=Your_strong_password123;Encrypt=False;TrustServerCertificate=True;

Jwt__Issuer=SmartTravelAssistant
Jwt__Audience=SmartTravelAssistant.Client
Jwt__SecretKey=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=7

Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://127.0.0.1:5173
Cors__AllowedOrigins__2=http://localhost:5174
Cors__AllowedOrigins__3=http://127.0.0.1:5174

# Service-to-service audit (must match Audit__InternalKey on AuditService)
AuditService__BaseUrl=http://localhost:65486/
Audit__InternalKey=dev-audit-internal-key

NotificationService__BaseUrl=http://localhost:62375/
Notification__InternalKey=dev-notification-internal-key

# Stripe (PaymentService) — optional
# Stripe__SecretKey=
# Stripe__WebhookSecret=

# PayPal (PaymentService) — optional
# PayPal__BaseUrl=https://api-m.sandbox.paypal.com/
# PayPal__ClientId=
# PayPal__ClientSecret=
# PayPal__WebhookId=
