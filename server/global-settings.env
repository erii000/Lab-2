# Copy to .env and never commit real secrets
# ASP.NET Core reads env vars automatically.

# Connection string (when DB is ready)
ConnectionStrings__DefaultConnection=Server=tcp:sqladminlab.database.windows.net,1433;Initial Catalog=lab2DB;Persist Security Info=False;User ID=sqladmin;Password=admin123!;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# JWT configuration
Jwt__Issuer=SmartTravelAssistant
Jwt__Audience=SmartTravelAssistant.Client
Jwt__SecretKey=REPLACE_WITH_LONG_RANDOM_SECRET_32_CHARS_MIN
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=7

# CORS trusted frontend origins (comma separated for local use)
Cors__AllowedOrigins__0=http://localhost:5173

# Stripe (PaymentService) — set in PaymentService/.env for local runs; never commit secrets
# Stripe__SecretKey=
# Stripe__WebhookSecret=

# PayPal (PaymentService) — sandbox first; never commit secrets
# PayPal__BaseUrl=https://api-m.sandbox.paypal.com/
# PayPal__ClientId=
# PayPal__ClientSecret=

# AviationStack (WeatherExternalDataService) — optional flight status
# ExternalApis__AviationStack__AccessKey=
