# Docker + team lab: Azure SQL (required — LocalDB does NOT work inside Linux containers).
# For SQL Server on Windows only (no Docker), use:
# Server=(localdb)\mssqllocaldb;Database=lab2DB;Trusted_Connection=True;TrustServerCertificate=True;

ConnectionStrings__DefaultConnection=Server=tcp:sqladminlab.database.windows.net,1433;Initial Catalog=lab2DB;Persist Security Info=False;User ID=sqladmin;Password=admin123!;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;

Jwt__Issuer=SmartTravelAssistant
Jwt__Audience=SmartTravelAssistant.Client
Jwt__SecretKey=SmartTravelAssistantDevJwtSecretKey2026_ChangeInProduction!
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=7

Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://127.0.0.1:5173
Cors__AllowedOrigins__2=http://localhost:5174
Cors__AllowedOrigins__3=http://127.0.0.1:5174

# In Docker, compose overrides these with service hostnames (auditservice, notificationservice).
AuditService__BaseUrl=http://auditservice:8080/
Audit__InternalKey=dev-audit-internal-key

NotificationService__BaseUrl=http://notificationservice:8080/
Notification__InternalKey=dev-notification-internal-key
