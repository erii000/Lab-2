# Used by docker compose — SQL Server in the mssql container (reachable from all API containers).
# Connect SSMS to: localhost,1433  user=sa  password=Your_strong_password123  database=lab2DB

ConnectionStrings__DefaultConnection=Server=mssql,1433;Initial Catalog=lab2DB;User ID=sa;Password=Your_strong_password123;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=False;Connection Timeout=30;

Jwt__Issuer=SmartTravelAssistant
Jwt__Audience=SmartTravelAssistant.Client
Jwt__SecretKey=SmartTravelAssistantDevJwtSecretKey2026!
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=7

Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://127.0.0.1:5173
Cors__AllowedOrigins__2=http://localhost:5174
Cors__AllowedOrigins__3=http://127.0.0.1:5174
