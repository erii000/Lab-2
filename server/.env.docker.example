MSSQL_SA_PASSWORD=Your_strong_password123

# Must match Server=mssql and Password= above; Initial Catalog lab2DB is created by docker-compose service mssql-init.
JWT__ISSUER=SmartTravelAssistant
JWT__AUDIENCE=SmartTravelAssistant.Client
JWT__SECRETKEY=REPLACE_WITH_LONG_RANDOM_SECRET_32_CHARS_MIN
JWT__ACCESSTOKENMINUTES=30
JWT__REFRESHTOKENDAYS=7

CORS__ALLOWEDORIGINS__0=http://localhost:5173

# Docker Compose loads server/global-settings.env (Azure lab2DB) for all API services.
# For local Docker SQL only, copy this file to .env and uncomment:
# CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=mssql,1433;Initial Catalog=lab2DB;User ID=sa;Password=Your_strong_password123;Encrypt=False;TrustServerCertificate=True;

# Optional payment/weather integrations
STRIPE__SECRETKEY=
STRIPE__WEBHOOKSECRET=
PAYPAL__BASEURL=https://api-m.sandbox.paypal.com/
PAYPAL__CLIENTID=
PAYPAL__CLIENTSECRET=
PAYPAL__WEBHOOKID=
EXTERNALAPIS__AVIATIONSTACK__ACCESSKEY=
EXTERNALAPIS__TRANSPORT__BASEURL=
EXTERNALAPIS__TRANSPORT__APIKEY=
