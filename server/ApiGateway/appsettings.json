{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SmartTravelDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "SmartTravelAssistant",
    "Audience": "SmartTravelAssistant.Client",
    "SecretKey": "CHANGE_THIS_IN_ENV_OR_USER_SECRETS",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },

  "ReverseProxy": {
    "Routes": {
      "notification-hub": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/hubs/notifications" },
        "Metadata": {
          "WebSocketsEnabled": "true"
        }
      },
      "chat-hub": {
        "ClusterId": "rtc-cluster",
        "Match": { "Path": "/hubs/chat" },
        "Metadata": {
          "WebSocketsEnabled": "true"
        }
      },
      "rtc-chat": {
        "ClusterId": "rtc-cluster",
        "Match": { "Path": "/api/chat/{**catch-all}" }
      },
      "rtc-chat-v1": {
        "ClusterId": "rtc-cluster",
        "Match": { "Path": "/api/v1/chat/{**catch-all}" }
      },
      "rtc-chat-v1-root": {
        "ClusterId": "rtc-cluster",
        "Match": { "Path": "/api/v1/chat" }
      },
      "user-auth": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "user-auth-v1": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "user-users": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/v1/users/{**catch-all}" }
      },
      "user-admin": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/v1/admin/{**catch-all}" }
      },
      "user-ping": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/user/{**catch-all}" }
      },
      "itinerary-api": {
        "ClusterId": "itinerary-cluster",
        "Match": { "Path": "/api/v1/itineraries/{**catch-all}" }
      },
      "destinations-api": {
        "ClusterId": "itinerary-cluster",
        "Match": { "Path": "/api/v1/destinations/{**catch-all}" }
      },
      "destinations-root": {
        "ClusterId": "itinerary-cluster",
        "Match": { "Path": "/api/v1/destinations" }
      },
      "saved-destinations-api": {
        "ClusterId": "itinerary-cluster",
        "Match": { "Path": "/api/v1/saved-destinations/{**catch-all}" }
      },
      "saved-destinations-root": {
        "ClusterId": "itinerary-cluster",
        "Match": { "Path": "/api/v1/saved-destinations" }
      },
      "travel-preferences-api": {
        "ClusterId": "itinerary-cluster",
        "Match": { "Path": "/api/v1/travel-preferences/{**catch-all}" }
      },
      "support-v1-api": {
        "ClusterId": "support-cluster",
        "Match": { "Path": "/api/v1/supporttickets/{**catch-all}" }
      },
      "support-v1-root": {
        "ClusterId": "support-cluster",
        "Match": { "Path": "/api/v1/supporttickets" }
      },
      "booking-api": {
        "ClusterId": "booking-cluster",
        "Match": { "Path": "/api/v1/bookings/{**catch-all}" }
      },
      "booking-reports": {
        "ClusterId": "booking-cluster",
        "Match": { "Path": "/api/v1/reports/{**catch-all}" }
      },
      "payment-api": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/v1/payments/{**catch-all}" }
      },
      "notifications-v1": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/v1/notifications/{**catch-all}" }
      },
      "notifications-root": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/notifications" }
      },
      "notifications-v1-root": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/v1/notifications" }
      },
      "notifications-legacy": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "audit-api": {
        "ClusterId": "audit-cluster",
        "Match": { "Path": "/api/auditlogs/{**catch-all}" }
      },
      "audit-v1": {
        "ClusterId": "audit-cluster",
        "Match": { "Path": "/api/v1/auditlogs/{**catch-all}" }
      },
      "weather-api": {
        "ClusterId": "weather-cluster",
        "Match": { "Path": "/api/v1/weather/{**catch-all}" }
      },
      "flights-api": {
        "ClusterId": "weather-cluster",
        "Match": { "Path": "/api/v1/flights/{**catch-all}" }
      },
      "transport-api": {
        "ClusterId": "weather-cluster",
        "Match": { "Path": "/api/v1/transport/{**catch-all}" }
      },
      "support-root": {
        "ClusterId": "support-cluster",
        "Match": { "Path": "/api/supporttickets" }
      },
      "support-api": {
        "ClusterId": "support-cluster",
        "Match": { "Path": "/api/supporttickets/{**catch-all}" }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:62381/" }
        }
      },
      "itinerary-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:63189/" }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:63191/" }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:63187/" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:62375/" }
        }
      },
      "audit-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:65486/" }
        }
      },
      "rtc-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:62379/" }
        }
      },
      "weather-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:61219/" }
        }
      },
      "support-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:50395/" }
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
